<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Premium Store</title>
    
    <!-- Google Fonts: Inter (UI) + Space Grotesk (display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Global CSS -->
    <link rel="stylesheet" href="/css/global.css">
    
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Tailwind (Play CDN) — usado nos toasts/alerts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { corePlugins: { preflight: false } }</script>

    <link rel="stylesheet" href="/css/auth.css">
</head>
<body>
    
    <div class="auth-container">
        <div class="auth-form-container">
            <a href="/" class="auth-brand">PREMIUM STORE</a>
            
            <div class="auth-header">
                <h1>Bem-vindo de volta</h1>
                <p>Faça login para acessar sua conta exclusiva.</p>
            </div>
            
            <div>
                <div class="form-group">
                    <label for="email">Email</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-regular fa-envelope"></i>
                        <input type="email" class="form-control-icon" id="email" name="emailLogin" placeholder="seu@email.com">
                    </div>
                </div>
                
                <div class="form-group">
                    <label for="senha">Senha</label>
                    <div class="input-icon-wrapper">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" class="form-control-icon" id="senha" name="senhaLogin" placeholder="••••••••">
                    </div>
                </div>
                
                <button onclick="efetuarLogin()" class="btn-auth">Entrar na Minha Conta</button>
            </div>
            
            <div class="auth-footer">
                Não possui uma conta? <a href="/cadastrar">Cadastre-se agora</a>
            </div>
        </div>
        
        <div class="auth-banner">
            <span class="auth-banner-mark">Premium</span>
            <div class="auth-banner-overlay">
                <h2>Estilo e autenticidade</h2>
                <p>Seleção local de calçados, camisas, bonés e acessórios — entrega combinada pelo WhatsApp.</p>
            </div>
        </div>
    </div>

    <script src="/js/ui/toast.js"></script>
    <script src="/js/login/fetchLogin.js"></script>
</body>
</html>