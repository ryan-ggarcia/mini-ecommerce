<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Premium Store</title>
    
    <!-- Google Fonts: Inter (UI) + Space Grotesk (display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Global CSS -->
    <link rel="stylesheet" href="/css/global.css">
    
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- IMask for input masks -->
    <script src="https://unpkg.com/imask"></script>

    <!-- Tailwind (Play CDN) — usado nos toasts/alerts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { corePlugins: { preflight: false } }</script>

    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="brand">PREMIUM ADMIN</div>
            <ul class="admin-nav">
                <li><a href="/admin/"><i class="fa-solid fa-gauge"></i> Dashboard</a></li>
                <li><a href="/admin/listarProduto"><i class="fa-solid fa-box"></i> Produtos</a></li>
                <li><a href="/admin/listar"><i class="fa-solid fa-users"></i> Usuários</a></li>
                <li><a href="/admin/vendas"><i class="fa-solid fa-solid fa-money-bill"></i> Vendas</a></li>
                <li><a href="/admin/perfil"><i class="fa-solid fa-circle-user"></i> Meu Perfil</a></li>
                <li><a href="/home"><i class="fa-solid fa-arrow-right-from-bracket"></i> Voltar à Loja</a></li>
            </ul>
        </aside>
        
        <main class="admin-main">
            <%- body %>
        </main>
    </div>

    <!-- Toasts / diálogos estilizados (substituem alert/confirm) -->
    <script src="/js/ui/toast.js"></script>
</body>
</html>
