<% const clientes = (user || []).filter(u => u.getPer_id == 2); %>

<div class="admin-header">
    <div class="admin-header-left">
        <h2>Usuários</h2>
        <span class="admin-count"><%= clientes.length %> <%= clientes.length === 1 ? 'cliente' : 'clientes' %></span>
    </div>
    <a href="/admin/cadastrar" class="btn-action btn-add"><i class="fa-solid fa-plus"></i> Novo usuário</a>
</div>
<div class="filter-container">
    <div class="filter-form">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="produto-search" class="filter-input" placeholder="Pesquisar por nome..."
            oninput="montarTabela(this.value)" autocomplete="off">
    </div>
</div>

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Perfil</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Telefone</th>
                <th>Data Nasc.</th>
                <th>CPF</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody id="user_table">
            <% if(clientes.length > 0){ %>
                <% clientes.forEach(u => { %>
                    <% const ativo = (u.getUsu_status === 'ATIVO' || u.getUsu_status == 1); %>
                    <tr>
                        <td class="num"><%= u.getUsu_id %></td>
                        <td><span class="badge <%= ativo ? 'badge--ok' : 'badge--out' %>"><%= u.getUsu_status %></span></td>
                        <td><%= u.getPer_id %></td>
                        <td style="font-weight: 500;"><%= u.getUsu_nome %></td>
                        <td><%= u.getUsu_email %></td>
                        <td class="num"><%= u.getUsu_telefone %></td>
                        <td>
                            <%
                                let formattedDate = '';
                                if(u.getUsu_data) {
                                    let d = new Date(u.getUsu_data);
                                    if(!isNaN(d.getTime())) {
                                        formattedDate = d.toLocaleDateString('pt-BR', {timeZone: 'UTC'});
                                    } else {
                                        formattedDate = u.getUsu_data;
                                    }
                                }
                            %>
                            <%= formattedDate %>
                        </td>
                        <td class="num"><%= u.getUsu_cpf %></td>
                        <td>
                            <div class="table-actions">
                                <button data-end="<%= u.getEnd_id %>" class="btn-action btn-view open-modal" title="Ver endereço"><i class="fa-solid fa-map-location-dot"></i></button>
                                <a href="/admin/update/<%= u.getUsu_id %>" class="btn-action btn-edit" title="Editar"><i class="fa-solid fa-pen"></i></a>
                                <button data-id="<%= u.getUsu_id %>" class="btn-action btn-delete" title="Excluir"><i class="fa-solid fa-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="9" class="admin-empty">Nenhum usuário cadastrado no momento.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<div class="modal admin-modal" style="display: none;">
    <div class="admin-modal-card">
        <button class="admin-modal-close close-modal" aria-label="Fechar"><i class="fa-solid fa-xmark"></i></button>
        <h3>Endereço do usuário</h3>

        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>CEP</th>
                        <th>UF</th>
                        <th>Cidade</th>
                        <th>Bairro</th>
                        <th>Rua</th>
                        <th>Número</th>
                        <th>Complemento</th>
                    </tr>
                </thead>
                <tbody id="end_table">
                    <!-- Renderizado pelo JS -->
                </tbody>
            </table>
        </div>

        <div class="form-footer" style="text-align: right; margin-top: 1.5rem;">
            <button class="btn-action btn-edit close-modal" style="width: auto;">Fechar</button>
        </div>
    </div>
</div>

<script src="/js/user/fetchDelete.js"></script>
<script src="/js/user/modalEnd.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const modal = document.querySelector('.modal');
        const btnsOpen = document.querySelectorAll('.open-modal');
        const btnsClose = document.querySelectorAll('.close-modal');

        btnsOpen.forEach(btn => {
            btn.addEventListener('click', () => { modal.style.display = 'flex'; });
        });

        btnsClose.forEach(btn => {
            btn.addEventListener('click', () => { modal.style.display = 'none'; });
        });

        modal.addEventListener('click', (e) => {
            if(e.target === modal) { modal.style.display = 'none'; }
        });
    });
</script>
