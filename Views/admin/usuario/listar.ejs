<link rel="stylesheet" href="/css/user/style-modal.css">

<div class="admin-header">
    <h2>Listagem de Usuários</h2>
    <a href="/admin/cadastrar" class="btn-action btn-add"><i class="fa-solid fa-plus"></i> Novo Usuário</a>
</div>

<div class="admin-table-container">
    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Status</th>
                <th>Perfil</th>
                <th>Nome</th>
                <th>Email</th>
                <th>Telefone</th>
                <th>Data Nasc.</th>
                <th>CPF</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% if(user.length > 0 ){ %>
                <% user.forEach(u => { %>
                    <% if(u.getPer_id == 2){ %>
                        <tr>
                            <td><%= u.getUsu_id %></td>
                            <td>
                                <span style="padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; 
                                    <% if(u.getUsu_status === 'ATIVO' || u.getUsu_status == 1){ %> background: #dcfce7; color: #166534; 
                                    <% } else { %> background: #fee2e2; color: #991b1b; <% } %>">
                                    <%= u.getUsu_status %>
                                </span>
                            </td>
                            <td><%= u.getPer_id %></td>
                            <td style="font-weight: 500;"><%= u.getUsu_nome %></td>
                            <td><%= u.getUsu_email %></td>
                            <td><%= u.getUsu_telefone %></td>
                            <td>
                                <% 
                                    let formattedDate = '';
                                    if(u.getUsu_data) {
                                        let d = new Date(u.getUsu_data);
                                        // Ensure it doesn't show NaN/NaN/NaN
                                        if(!isNaN(d.getTime())) {
                                            formattedDate = d.toLocaleDateString('pt-BR', {timeZone: 'UTC'});
                                        } else {
                                            formattedDate = u.getUsu_data; // fallback
                                        }
                                    }
                                %>
                                <%= formattedDate %>
                            </td>
                            <td><%= u.getUsu_cpf %></td>
                            <td>
                                <div style="display: flex; gap: 0.5rem;">
                                    <button data-end="<%= u.getEnd_id %>" class="btn-action open-modal" style="background-color: var(--secondary); color: var(--text-main); padding: 0.25rem 0.5rem;" title="Ver Endereço"><i class="fa-solid fa-map-location-dot"></i></button>
                                    <a href="/admin/update/<%= u.getUsu_id %>" class="btn-action btn-edit" style="padding: 0.25rem 0.5rem;"><i class="fa-solid fa-pen"></i></a>
                                    <button data-id="<%= u.getUsu_id %>" class="btn-action btn-delete" style="padding: 0.25rem 0.5rem;"><i class="fa-solid fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                <% }) %>
            <% } else { %>
                <tr>
                    <td colspan="9" style="text-align: center; padding: 2rem; color: var(--text-muted);">
                        Nenhum usuário cadastrado no momento.
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
</div>

<div class="modal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div class="modal-card" style="background: white; padding: 2rem; border-radius: var(--radius-md); max-width: 800px; width: 100%; position: relative;">
        <h3 style="margin-bottom: 1.5rem; color: var(--text-main); border-bottom: 1px solid var(--border); padding-bottom: 0.5rem;">Endereço do Usuário</h3>
        
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>CEP</th>
                        <th>UF</th>
                        <th>Cidade</th>
                        <th>Bairro</th>
                        <th>Rua</th>
                        <th>Número</th>
                        <th>Complemento</th>
                    </tr>
                </thead>
                <tbody id="end_table">
                    <!-- O código sera renderizado pelo JS -->
                </tbody>
            </table>
        </div>
        
        <div style="margin-top: 2rem; text-align: right;">
            <button class="btn-action btn-edit close-modal" style="padding: 0.5rem 1.5rem;">Fechar</button>
        </div>
    </div>
</div>

<script src="/js/user/fetchDelete.js"></script>
<script src="/js/user/modalEnd.js"></script>

<!-- Add script inline to handle modal visibility logic simply with the class logic used in style-modal.css -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        // the original modalEnd.js handles the logic, but just in case we need to adapt display styling
        const modal = document.querySelector('.modal');
        const btnsOpen = document.querySelectorAll('.open-modal');
        const btnClose = document.querySelector('.close-modal');
        
        btnsOpen.forEach(btn => {
            btn.addEventListener('click', () => {
                modal.style.display = 'flex';
            });
        });
        
        btnClose.addEventListener('click', () => {
            modal.style.display = 'none';
        });
        
        modal.addEventListener('click', (e) => {
            if(e.target === modal) {
                modal.style.display = 'none';
            }
        });
    });
</script>