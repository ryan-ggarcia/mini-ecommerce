<link rel="stylesheet" href="/css/user/style-modal.css">
<div><h1>Listar Usuários</h1></div>
<div>
    <a href="/admin/cadastrar"> + Usuário</a>
</div>
<div>
    <table>
       <thead>
        <th>
            ID
        </th>
        <th>
            STATUS
        </th>
         <th>
            PERFIL
        </th>
        <th>
            NOME
        </th>
        <th>
            EMAIL
        </th>
        <th>
            TELEFONE
        </th>
        <th>
            DATA DE NASCIMENTO
        </th>
        <th>
            CPF
        </th>
        <th>
            AÇÕES
        </th>
       </thead>
       <tbody>
        <%if(user.length > 0 ){%>
            <%user.forEach(u =>{%>
                <%if(u.getPer_id == 2){%>
                <tr>
                    <td><%= u.getUsu_id%></td>
                    <td><%= u.getUsu_status%></td>
                    <td><%= u.getPer_id%></td>
                    <td><%= u.getUsu_nome%></td>
                    <td><%= u.getUsu_email%></td>
                    <td><%= u.getUsu_telefone%></td>
                    <td><%= u.getUsu_data%></td>
                    <td><%= u.getUsu_cpf%></td>
                    <td>
                        <button data-end="<%= u.getEnd_id%>" class="open-modal">Endereço</button>
                        <!-- Passando o Id do usuario pela URL e enviando para o router -->
                        <a href="/admin/update/<%= u.getUsu_id%>">Alterar</a>
                        <button data-id="<%= u.getUsu_id%>" class="btn-delete">Deletar</button>
                    </td>
                </tr>
                <%}%>
            <%})%>
        <%}else{%>
            <tr>
                <td>
                   Nenhum usuário cadastrado 
                </td>
            </tr>
        <%}%>
       </tbody>
    </table>
</div>
<div class="modal">
    <div class="modal-card">
        <div>
            <h2>Endereço</h2>
        </div>
        <div>
            <table>
                <thead>
                    <th>
                        ID
                    </th>
                    <th>
                        CEP
                    </th>
                    <th>
                        UF
                    </th>
                    <th>
                        CIDADE
                    </th>
                    <th>
                        BAIRRO
                    </th>
                    <th>
                        RUA
                    </th>
                    <th>
                        NUMERO
                    </th>
                    <th>
                        COMPLEMENTO
                    </th>
                </thead>
                <tbody>
                   
                </tbody>
            </table>
        </div>
        <button class="close-modal"> Fechar</button>
    </div>
</div>
<script src="/js/user/fetchDelete.js"></script>
<script src="/js/user/modalEnd.js"></script>