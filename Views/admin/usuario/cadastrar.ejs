<div class="admin-header">
    <h2>Cadastrar Usuário</h2>
    <a href="/admin/listar" class="btn-action btn-edit"><i class="fa-solid fa-arrow-left"></i> Voltar</a>
</div>

<div class="admin-form-card" style="max-width: 800px; margin: 0 auto;">
    <h3 style="margin-bottom: 1.5rem; color: var(--primary); border-bottom: 2px solid var(--border); padding-bottom: 0.5rem;">Informações Pessoais</h3>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;">
        <div class="form-group" style="grid-column: 1 / -1;">
            <label for="nome">Nome Completo</label>
            <input type="text" class="form-control" name="nome" id="nome" placeholder="Ex: João da Silva">
        </div>        
        
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" class="form-control" name="email" id="email" placeholder="joao@exemplo.com">
        </div>       
        
        <div class="form-group">
            <label for="cpf">CPF</label>
            <input type="text" class="form-control" name="cpf" id="cpf" placeholder="000.000.000-00">
        </div>
        
        <div class="form-group">
            <label for="senha">Senha</label>
            <input type="password" class="form-control" name="senha" id="senha" placeholder="******">
        </div>
        
        <div class="form-group">
            <label for="csenha">Confirmar Senha</label>
            <input type="password" class="form-control" name="csenha" id="csenha" placeholder="******">
        </div>
        
        <div class="form-group">
            <label for="data">Data de Nascimento</label>
            <input type="date" class="form-control" name="data" id="data">
        </div>        
        
        <div class="form-group">
            <label for="tel">Telefone</label>
            <input type="text" class="form-control" name="tel" id="tel" placeholder="(00) 00000-0000">
        </div>        
        
        <div class="form-group">
            <label for="profile">Perfil</label>
            <select class="form-control" name="profile" id="profile">
                <option value="0">--Nenhum--</option>
                <% if(perfil && perfil.length > 0){ %>
                    <% perfil.forEach(p => { %>
                        <option value="<%= p.getId %>"><%= p.getNome %></option>
                    <% }) %>
                <% } %>
            </select>
        </div>
    </div>

    <h3 style="margin-top: 2rem; margin-bottom: 1.5rem; color: var(--primary); border-bottom: 2px solid var(--border); padding-bottom: 0.5rem;">Endereço de Entrega</h3>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
        <div class="form-group">
            <label for="cep">CEP</label>
            <input type="text" class="form-control" name="cep" id="cep" placeholder="00000-000">
        </div>
        
        <div class="form-group">
            <label for="uf">UF</label>
            <input type="text" class="form-control" name="uf" id="uf" placeholder="SP" maxlength="2">
        </div>
        
        <div class="form-group" style="grid-column: 1 / -1;">
            <label for="cidade">Cidade</label>
            <input type="text" class="form-control" name="cidade" id="cidade" placeholder="São Paulo">
        </div>
        
        <div class="form-group">
            <label for="bairro">Bairro</label>
            <input type="text" class="form-control" name="bairro" id="bairro" placeholder="Centro">
        </div>
        
        <div class="form-group" style="grid-column: 1 / -1;">
            <label for="rua">Rua</label>
            <input type="text" class="form-control" name="rua" id="rua" placeholder="Rua das Flores">
        </div>
        
        <div class="form-group">
            <label for="numero">Número</label>
            <input type="number" class="form-control" name="numero" id="numero" placeholder="123">
        </div>
        
        <div class="form-group">
            <label for="comple">Complemento</label>
            <input type="text" class="form-control" name="comple" id="comple" placeholder="Apto 42">
        </div>
    </div>

    <div style="margin-top: 3rem; border-top: 1px solid var(--border); padding-top: 1.5rem;">
        <button id="btn-register" type="button" class="btn-action btn-add" style="font-size: 1.1rem; padding: 1rem 2rem; width: 100%; justify-content: center; background-color: var(--primary);">
            <i class="fa-solid fa-user-plus"></i> Finalizar Cadastro de Usuário
        </button>
    </div>
</div>

<script src="/js/user/fetchRegister.js"></script>
<script src="/js/admin/usuarioForm.js"></script>