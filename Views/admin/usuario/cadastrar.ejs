<div>
    <h1>
        Cadastrar Usuário
    </h1>
</div>

<div>
    <div>
        <h1>Informações Pessoais</h1>
        <div>
            <label for="text">Nome</label>
            <input type="text" name="nome" id="nome">
        </div>        
        <div>
            <label for="text">Email</label>
            <input type="text" name="email" id="email">
        </div>        
        <div>
            <label for="text">Senha</label>
            <input type="password" name="senha" id="senha">
        </div>
        <div>
            <label for="text">Confirmar senha</label>
            <input type="password" name="csenha" id="csenha">
        </div>
        <div>
            <label for="text">Data de nascimento</label>
            <input type="date" name="data" id="data">
        </div>        
        <div>
            <label for="text">Telefone</label>
            <input type="text" name="tel" id="tel">
        </div>        
        <div>
            <label for="text">Cpf</label>
            <input type="text" name="cpf" id="cpf">
        </div>
        <div>
            <label for="text">Perfil</label>
            <select name="perfil" id="perfil">
                <option value="0">--Nenhum--</option>
                <%if(perfil.length > 0){%>
                    <%perfil.forEach(p =>{%>
                        <option value="<%= perfil.per_id %>"><%= perfil.per_nome %></option>
                    <%})%>
                <%}%>
            </select>
        </div>        
    </div>
    <div>
        <h1>Endereço</h1>
         <div>
            <label for="text">CEP</label>
            <input type="text" name="cep" id="cep">
        </div>
        <div>
            <label for="text">UF</label>
            <input type="text" name="uf" id="uf">
        </div>
        <div>
            <label for="text">Cidade</label>
            <input type="text" name="cidade" id="cidade">
        </div>
        <div>
             <label for="text">Bairro</label>
            <input type="text" name="bairro" id="bairro">
        </div>
        <div>
            <label for="text">Rua</label>
            <input type="text" name="rua" id="rua">
        </div>
        <div>
            <label for="text">Número da rua</label>
            <input type="number" name="numero" id="numero">
        </div>
        <div>
            <label for="text">Complemento</label>
            <input type="text" name="comple" id="comple">
        </div>
         <div>
            <a href="/admin/listar">Voltar</a>
            <button id="btn-register" type="button">Cadastrar</button>
        </div>
    </div>
</div>
<script src="/js/user/fetchRegister.js"></script>