<div class="admin-header">
    <h2>Alterar usuário</h2>
    <a href="/admin/listar" class="btn-action btn-edit"><i class="fa-solid fa-arrow-left"></i> Voltar</a>
</div>

<div class="admin-form-card">
    <input type="hidden" name="id" id="id" value="<%= getUser.getUsu_id %>">
    <input type="hidden" name="endId" id="endId" value="<%= getUser.getEnd_id %>">

    <div class="admin-form-grid">
        <h3 class="form-section-title">Informações pessoais</h3>

        <div class="form-group span-2">
            <label for="nome">Nome completo</label>
            <input type="text" class="form-control" name="nome" id="nome" value="<%= getUser.getUsu_nome %>">
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" class="form-control" name="email" id="email" value="<%= getUser.getUsu_email %>">
        </div>

        <div class="form-group">
            <label for="cpf">CPF</label>
            <input type="text" class="form-control" name="cpf" id="cpf" value="<%= getUser.getUsu_cpf %>">
        </div>

        <div class="form-group">
            <label for="senha">Nova senha</label>
            <input type="password" class="form-control" name="senha" id="senha" placeholder="Deixe 0 para manter a senha atual">
        </div>

        <div class="form-group">
            <label for="data">Data de nascimento</label>
            <input type="date" class="form-control" name="data" id="data" value="<%= getUser.getUsu_data %>">
        </div>

        <div class="form-group">
            <label for="tel">Telefone</label>
            <input type="text" class="form-control" name="tel" id="tel" value="<%= getUser.getUsu_telefone %>">
        </div>

        <div class="form-group">
            <label for="profile">Perfil</label>
            <select class="form-control" name="profile" id="profile">
                <option value="0">--Nenhum--</option>
                <% if(perfil && perfil.length > 0){ %>
                    <% perfil.forEach(p => { %>
                        <option value="<%= p.getId %>" <%= getUser.getPer_id == p.getId ? 'selected' : '' %>><%= p.getNome %></option>
                    <% }) %>
                <% } %>
            </select>
        </div>

        <div class="form-group">
            <label for="status">Status</label>
            <select class="form-control" name="status" id="status">
                <option value="ATIVO" <%= getUser.getUsu_status === 'ATIVO' ? 'selected' : '' %>>Ativo</option>
                <option value="INATIVO" <%= getUser.getUsu_status === 'INATIVO' ? 'selected' : '' %>>Inativo</option>
            </select>
        </div>

        <h3 class="form-section-title">Endereço de entrega</h3>

        <div class="form-group">
            <label for="cep">CEP</label>
            <input type="text" class="form-control" name="cep" id="cep" value="<%= end.getEnd_cep %>">
        </div>

        <div class="form-group">
            <label for="uf">UF</label>
            <input type="text" class="form-control" name="uf" id="uf" value="<%= end.getEnd_uf %>" maxlength="2">
        </div>

        <div class="form-group span-2">
            <label for="cidade">Cidade</label>
            <input type="text" class="form-control" name="cidade" id="cidade" value="<%= end.getEnd_cidade %>">
        </div>

        <div class="form-group">
            <label for="bairro">Bairro</label>
            <input type="text" class="form-control" name="bairro" id="bairro" value="<%= end.getEnd_bairro %>">
        </div>

        <div class="form-group span-2">
            <label for="rua">Rua</label>
            <input type="text" class="form-control" name="rua" id="rua" value="<%= end.getEnd_rua %>">
        </div>

        <div class="form-group">
            <label for="numero">Número</label>
            <input type="number" class="form-control" name="numero" id="numero" value="<%= end.getEnd_numero %>">
        </div>

        <div class="form-group">
            <label for="comple">Complemento</label>
            <input type="text" class="form-control" name="comple" id="comple" value="<%= end.getEnd_complemento %>">
        </div>
    </div>

    <div class="form-footer">
        <button id="btn-update" type="button" class="btn-action btn-add btn-submit">
            <i class="fa-solid fa-save"></i> Atualizar usuário
        </button>
    </div>
</div>

<script src="/js/user/fetchUpdate.js"></script>
<script src="/js/admin/usuarioForm.js"></script>
