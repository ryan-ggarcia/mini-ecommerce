<script src="/js/product/fetchUpdate.js"></script>

<div class="admin-header">
    <h2>Alterar produto</h2>
    <a href="/admin/listarProduto" class="btn-action btn-edit"><i class="fa-solid fa-arrow-left"></i> Voltar</a>
</div>

<div class="admin-form-card">
    <input type="hidden" name="id" id="id" value="<%=produto.getPro_id()%>">

    <div class="admin-form-grid">
        <div class="form-group span-2">
            <label for="nome">Nome do produto</label>
            <input type="text" class="form-control" name="nome" id="nome" value="<%=produto.getPro_nome()%>">
        </div>

        <div class="form-group">
            <label for="preco">Preço (R$)</label>
            <input type="text" class="form-control" name="preco" id="preco" value="<%=produto.getPro_preco()%>">
        </div>

        <div class="form-group">
            <label for="desconto">Desconto (%)</label>
            <input type="number" class="form-control" name="desconto" id="desconto" min="0" max="100" step="1" value="<%= parseFloat(produto.getPro_desconto()) || 0 %>">
            <small class="form-hint">Deixe 0 para produto sem promoção.</small>
        </div>

        <div class="form-group">
            <label for="quant">Quantidade em estoque</label>
            <input type="number" class="form-control" name="quant" id="quant" value="<%=produto.getPro_quantidade()%>">
        </div>

        <div class="form-group">
            <label for="status">Status</label>
            <select class="form-control" name="status" id="status">
                <option value="EM ESTOQUE" <%if(produto.getPro_status() === 'EM ESTOQUE'){%>selected<%}%>>Em estoque</option>
                <option value="SEM ESTOQUE" <%if(produto.getPro_status() === 'SEM ESTOQUE'){%>selected<%}%>>Sem estoque</option>
                <option value="SALDO" <%if(produto.getPro_status() === 'SALDO'){%>selected<%}%>>Saldo</option>
            </select>
        </div>

        <div class="form-group">
            <label for="cat">Categoria</label>
            <select class="form-control" name="cat" id="cat">
                <option value="0">--Nenhum--</option>
                <% if(cat && cat.length > 0){ %>
                    <% cat.forEach(c => { %>
                        <option value="<%=c.getCat_id()%>" <%= c.getCat_id() === produto.getCat_id() ? 'selected' : '' %>><%=c.getCat_nome()%></option>
                    <% }) %>
                <% } %>
            </select>
        </div>

        <div class="form-group">
            <label for="marca">Marca</label>
            <select class="form-control" name="marca" id="marca">
                <option value="0">--Nenhum--</option>
                <% if(marca && marca.length > 0){ %>
                    <% marca.forEach(m => { %>
                        <option value="<%=m.getMarca_id()%>" <%= m.getMarca_id() === produto.getMarca_id() ? 'selected' : '' %>><%=m.getMarca_nome()%></option>
                    <% }) %>
                <% } %>
            </select>
        </div>

        <div class="form-group span-2">
            <label for="img">Imagem do produto (opcional)</label>
            <input type="file" class="form-control" name="img" id="img" accept="image/*">
            <div id="divPrevImg">
                <span class="form-hint">Prévia da imagem atual</span>
                <div class="img-preview">
                    <img alt="prevImg" id="imgPrev" src="<%= produto.getPro_image() ? '/image/produtos/' + produto.getPro_image() : '' %>" data-img="<%= produto.getPro_image()%>">
                </div>
            </div>
        </div>

        <div class="form-group span-2">
            <label for="desc">Descrição detalhada</label>
            <textarea class="form-control" name="desc" id="desc" rows="4"><%=produto.getPro_desc()%></textarea>
        </div>
    </div>

    <div class="form-footer">
        <button type="button" id="btn-update" class="btn-action btn-add btn-submit">
            <i class="fa-solid fa-save"></i> Atualizar produto
        </button>
    </div>
</div>

<script src="/js/admin/produtoForm.js"></script>
