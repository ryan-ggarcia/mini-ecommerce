<link rel="stylesheet" href="/css/carrinho.css">

<section class="cart">
    <div class="cart-main">
        <header class="cart-head">
            <span class="cart-eyebrow">Seu carrinho</span>
            <h1>Revise seu pedido</h1>
        </header>

        <div id="produtos-carrinho" class="cart-list">
            <p class="cart-loading">Carregando produtos…</p>
        </div>
        <div class="clear"></div>
    </div>

    <aside class="cart-summary">
        <h2>Resumo</h2>
        <div id="conta" class="cart-account"></div>
        <div class="formaPagamento"></div>
        <button class="btn-checkout">Finalizar pedido <i class="fa-solid fa-arrow-right"></i></button>
        <p class="cart-note"><i class="fa-brands fa-whatsapp"></i> Entrega combinada pelo WhatsApp após o pedido.</p>
    </aside>
</section>

<script src="/js/carrinho/venda.js"></script>
