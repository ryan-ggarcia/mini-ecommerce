<!-- Estilos do Carrossel -->
<link rel="stylesheet" href="/css/home.css">

<div class="carousel-container" id="main-carousel">
    <div class="carousel-slide active" style="background-image: url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1600&q=80')">
        <div class="carousel-content">
            <h2>Coleção Exclusiva 2026</h2>
            <p>Elegância e sofisticação em cada detalhe.</p>
        </div>
    </div>
    <div class="carousel-slide" style="background-image: url('https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=1600&q=80')">
        <div class="carousel-content">
            <h2>Inverno Premium</h2>
            <p>Conforto absoluto com nossas peças selecionadas.</p>
        </div>
    </div>
    <div class="carousel-slide" style="background-image: url('https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=1600&q=80')">
        <div class="carousel-content">
            <h2>Acessórios de Luxo</h2>
            <p>O toque final que transforma o seu visual.</p>
        </div>
    </div>

    <div class="carousel-nav">
        <div class="carousel-dot active" onclick="goToSlide(0)"></div>
        <div class="carousel-dot" onclick="goToSlide(1)"></div>
        <div class="carousel-dot" onclick="goToSlide(2)"></div>
    </div>
</div>

<script src="/js/home/carousel.js"></script>

<section class="hero" style="height: auto; padding: 6rem 1rem;">
    <div class="hero-content">
        <h1>Descubra o Seu Estilo Premium</h1>
        <p>A melhor seleção de calçados, camisas, bonés e acessórios das marcas mais exclusivas.</p>
        <a href="#produtos" class="btn-primary">Ver Coleção</a>
    </div>
</section>

<section id="produtos" class="section">
    <div class="section-header">
        <h2>Nossa Coleção</h2>
        <p>Os itens mais desejados da temporada.</p>
    </div>

    <div class="grid grid-cols-4">
        <% if (typeof produtos !== 'undefined' && produtos.length > 0) { %>
            <% produtos.forEach(p => { %>
                <a href="/home/produto/<%= p.getPro_id() %>" class="product-card">
                    <div class="product-img-wrapper">
                        <img src="/image/produtos/<%= p.getPro_image() %>" alt="<%= p.getPro_nome() %>">
                    </div>
                    <div class="product-info">
                        <div class="product-brand">Marca: <%= p.getMarca_id() %></div>
                        <h3 class="product-title"><%= p.getPro_nome() %></h3>
                        <div class="product-price">R$ <%= parseFloat(p.getPro_preco()).toFixed(2) %></div>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0;">
                <h3 style="color: var(--text-muted);">Nenhum produto encontrado no momento.</h3>
            </div>
        <% } %>
    </div>
</section>
