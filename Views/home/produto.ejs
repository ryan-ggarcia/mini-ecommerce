<div class="product-detail-container">
    <% if (typeof produto !== 'undefined' && produto) { %>
        <div class="product-gallery">
            <% if (produto.getPro_image()) { %>
                <img src="/image/produtos/<%= produto.getPro_image() %>" alt="<%= produto.getPro_nome() %>">
            <% } else { %>
                <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background-color:var(--bg-off);">
                    <span style="color:var(--text-muted)">Sem imagem</span>
                </div>
            <% } %>
        </div>
        
        <div class="product-meta">
            <div class="brand">
                <%= produto.getMarca_nome() || ('Marca ' + produto.getMarca_id()) %>
                <% if (produto.getCat_nome()) { %> &middot; <%= produto.getCat_nome() %><% } %>
            </div>
            <h1 class="text-gradient"><%= produto.getPro_nome() %></h1>

            <div class="price">
                <% if (produto.emPromocao()) { %>
                    <span class="price-strike">R$ <%= parseFloat(produto.getPro_preco()).toFixed(2) %></span>
                    <span class="price-final">R$ <%= produto.getPrecoFinal().toFixed(2) %></span>
                    <span class="price-off">-<%= parseFloat(produto.getPro_desconto()) %>%</span>
                <% } else { %>
                    R$ <%= parseFloat(produto.getPro_preco()).toFixed(2) %>
                <% } %>
            </div>
            
            <p class="product-description">
                <%= produto.getPro_desc() ? produto.getPro_desc() : 'Produto exclusivo Premium Store.' %>
            </p>
            
            <p class="product-description" style="font-size: 0.9rem; margin-top: -1rem; margin-bottom: 2rem;">
                <i class="fa-solid fa-box"></i> Em estoque: <%= produto.getPro_quantidade() %> unidades
            </p>

            <button id="adicionar-carrinho" class="btn-add-cart" data-id="<%= produto.getPro_id() %>">
                Adicionar ao Carrinho
            </button>
        </div>
    <% } else { %>
        <div style="grid-column: 1 / -1; text-align: center; padding: 4rem 0;">
            <h3 style="color: var(--text-muted);">Produto não encontrado.</h3>
            <a href="/" class="btn-primary" style="margin-top: 1rem;">Voltar à Loja</a>
        </div>
    <% } %>
</div>

<% if (typeof relacionados !== 'undefined' && relacionados.length > 0) { %>
    <section class="section" style="max-width: 1240px; margin: 0 auto;">
        <div class="section-header">
            <div>
                <span class="section-kicker">Continue explorando</span>
                <h2>Você também pode gostar</h2>
            </div>
            <a href="/home/shop" class="btn-link">Ver loja completa <i class="fa-solid fa-arrow-right"></i></a>
        </div>
        <div class="grid grid-cols-4">
            <% relacionados.forEach(p => { %>
                <%- include('../partials/produto-card', { p: p }) %>
            <% }) %>
        </div>
    </section>
<% } %>

<script src="/js/carrinho/carrinho.js"></script>
